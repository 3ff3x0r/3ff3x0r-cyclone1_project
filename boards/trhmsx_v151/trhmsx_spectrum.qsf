set_global_assignment -name FAMILY Cyclone
set_global_assignment -name DEVICE EP1C12Q240C8
set_global_assignment -name TOP_LEVEL_ENTITY trhmsx_spectrum_top
set_global_assignment -name LAST_QUARTUS_VERSION "11.0 SP1"
set_global_assignment -name VERILOG_INPUT_VERSION VERILOG_2001
set_global_assignment -name USE_TIMEQUEST_TIMING_ANALYZER ON
set_global_assignment -name CYCLONE_CONFIGURATION_SCHEME "ACTIVE SERIAL"
set_global_assignment -name USE_CONFIGURATION_DEVICE ON
set_global_assignment -name CYCLONE_CONFIGURATION_DEVICE EPCS4
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

# Match the standalone SDRAM fit's c0/e0 clock names and U5 port names.
set_global_assignment -name SDC_FILE trhmsx_mem_fit.sdc
set_global_assignment -name SDC_FILE trhmsx_spectrum_cpu.sdc

# Source manifest. Use the project-owned T80 core with the pinned donor support files.
set_global_assignment -name VERILOG_FILE trhmsx_spectrum_top.v
set_global_assignment -name VERILOG_FILE ../../rtl/top/spectrum_top.v
set_global_assignment -name VERILOG_FILE ../../rtl/top/boot_orchestrator.v
set_global_assignment -name VERILOG_FILE ../../rtl/top/boot_bus_adapter.v
set_global_assignment -name VERILOG_FILE ../../rtl/memory/mem_subsystem.v
set_global_assignment -name VERILOG_FILE ../../rtl/memory/mem_arbiter.v
set_global_assignment -name VERILOG_FILE ../../rtl/memory/sdram_x16.v
set_global_assignment -name VERILOG_FILE ../../rtl/memory/screen_mirror.v
set_global_assignment -name VERILOG_FILE ../../rtl/core/core_subsystem.v
set_global_assignment -name VERILOG_FILE ../../rtl/core/cpu_clock_bridge.v
set_global_assignment -name VERILOG_FILE ../../rtl/core/spectrum_mmu.v
set_global_assignment -name VERILOG_FILE ../../rtl/core/spectrum_io.v
set_global_assignment -name VERILOG_FILE ../../rtl/core/spectrum_ula.v
set_global_assignment -name VERILOG_FILE ../../rtl/video/video_subsystem.v
set_global_assignment -name VERILOG_FILE ../../rtl/video/video_clock_enables.v
set_global_assignment -name VERILOG_FILE ../../rtl/video/video_scandoubler.v
set_global_assignment -name VERILOG_FILE ../../rtl/io/input_subsystem.v
set_global_assignment -name VERILOG_FILE ../../rtl/io/ps2_receiver.v
set_global_assignment -name VERILOG_FILE ../../rtl/io/spectrum_ps2_keyboard.v
set_global_assignment -name VERILOG_FILE ../../rtl/audio/audio_subsystem.v
set_global_assignment -name VERILOG_FILE ../../rtl/audio/ay_3_8912.v
set_global_assignment -name VERILOG_FILE ../../rtl/storage/boot_sd_bridge.v
set_global_assignment -name VERILOG_FILE ../../rtl/storage/sd_spi_reader.v
set_global_assignment -name VHDL_FILE ../../vendor/ZX_Spectrum-128K_MIST/T80/T80_Pack.vhd
set_global_assignment -name VHDL_FILE ../../vendor/ZX_Spectrum-128K_MIST/T80/T80_ALU.vhd
set_global_assignment -name VHDL_FILE ../../vendor/ZX_Spectrum-128K_MIST/T80/T80_MCode.vhd
